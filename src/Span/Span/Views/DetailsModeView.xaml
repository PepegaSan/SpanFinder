<UserControl
    x:Class="Span.Views.DetailsModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Span.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 헤더 버튼: 텍스트 좌측정렬 강제 -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{ThemeResource SpanTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Tapped="OnRootTapped" RightTapped="OnEmptyAreaRightTapped"
          Margin="4,6,4,6" CornerRadius="{StaticResource CardRadius}" Background="{ThemeResource SpanBgLayer1Brush}" BorderBrush="{ThemeResource SpanBorderCardBrush}" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Height="24"
              x:Name="HeaderGrid" AutomationProperties.AutomationId="Details_Header"
              Background="Transparent"
              BorderBrush="{ThemeResource SpanBorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              RightTapped="OnHeaderRightTapped">
            <!-- 0 = 아이콘, 1 = 이름. 나머지 컬럼(구분선 + 헤더)은 RebuildHeaderColumns가
                 DetailsColumns.All 순서대로 보이는 것만 추가한다 (탐색기 "열 선택"). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- Name Header -->
            <Button x:Name="NameHeaderButton" Grid.Column="0" Grid.ColumnSpan="2"
                    Content="Name"
                    Click="OnHeaderClick"
                    Tag="Name"
                    Padding="11,0,6,0"
                    Style="{StaticResource HeaderButtonStyle}"/>
        </Grid>

        <!-- Items List -->
        <Grid Grid.Row="1" x:Name="ListViewWrapper"
              Loaded="OnListViewWrapperLoaded" Unloaded="OnListViewWrapperUnloaded">
        <ListView x:Name="DetailsListView" AutomationProperties.AutomationId="Details_ListView"
                  ItemsSource="{Binding CurrentItems, Mode=OneWay}"
                  SelectedItem="{Binding CurrentFolder.SelectedChild, Mode=TwoWay}"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  AllowDrop="True"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  DragOver="OnListViewDragOver"
                  Drop="OnListViewDrop"
                  DragLeave="OnListViewDragLeave"
                  DoubleTapped="OnItemDoubleClick"
                  KeyDown="OnDetailsKeyDown"
                  SelectionChanged="OnDetailsSelectionChanged"
                  ContainerContentChanging="OnContainerContentChanging"
                  Background="Transparent"
                  Padding="0">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4,6,2" Background="{ThemeResource SpanBgLayer2Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Key}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SpanTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Count}"
                                           FontSize="10"
                                           Foreground="{ThemeResource SpanTextTertiaryBrush}"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <StaticResource ResourceKey="DetailsItemStyle"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileSystemViewModel">
                    <Grid Height="24" RightTapped="OnItemRightTapped"
                          ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}"
                          Opacity="{x:Bind ItemOpacity, Mode=OneWay}">
<!-- 데이터 셀: splitter 간격은 각 셀의 Margin.Left에 포함.
                             ApplyCellWidths에서 Border.Width + Margin 설정. -->
                        <!-- 셀 Grid.Column = DetailsColumns.All 인덱스 + 2 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon / Thumbnail / Custom Folder Icon -->
                        <Grid Grid.Column="0" Width="{Binding IconFontSize, Source={StaticResource FontScale}}" Height="{Binding IconFontSize, Source={StaticResource FontScale}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill"
                                   Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(HasThumbnail), Mode=OneWay}"/>
                            <Image Source="{x:Bind CustomIcon, Mode=OneWay}" Stretch="Uniform"
                                   Visibility="{x:Bind CustomIconVisibility, Mode=OneWay}"/>
                            <FontIcon FontFamily="{StaticResource RemixIcons}"
                                      Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                      Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                      FontSize="{Binding IconFontSize, Source={StaticResource FontScale}}"
                                      Visibility="{x:Bind vm:FileSystemViewModel.ShowIfFalseAndFalse(HasThumbnail, HasCustomIcon), Mode=OneWay}"/>
                            <!-- Issue #58: folder colour tag (top-left, overlay - no layout impact) -->
                            <Border Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(ShowTagDot), Mode=OneWay}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"
                                    Width="9" Height="9" CornerRadius="4.5"
                                    Background="{x:Bind TagBrush, Mode=OneWay}"
                                    IsHitTestVisible="False"/>
                            <!-- Cloud sync badge -->
                            <Border Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(HasCloudBadge), Mode=OneWay}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                    Width="12" Height="12" CornerRadius="6"
                                    Background="{x:Bind CloudBadgeBrush, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind CloudStateGlyph, Mode=OneWay}" FontSize="8"
                                          Foreground="{ThemeResource SpanTextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Color tag -->
                            <Border Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(HasColorTag), Mode=OneWay}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"
                                    Width="8" Height="8" CornerRadius="4"
                                    Background="{x:Bind ColorTagBrush, Mode=OneWay}"/>
                        </Grid>

                        <!-- Name (display) -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind TruncatedDisplayName, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding ItemFontSize, Source={StaticResource FontScale}}"
                                   Padding="6,0"
                                   Visibility="{x:Bind vm:FileSystemViewModel.NotRenaming(IsRenaming), Mode=OneWay}"/>
                        <!-- Rename TextBox (visible during rename) -->
                        <TextBox Grid.Column="1"
                                 Text="{x:Bind EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind IsRenaming, Mode=OneWay}"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0" MinHeight="0" FontSize="{Binding ItemFontSize, Source={StaticResource FontScale}}"
                                 LostFocus="OnRenameTextBoxLostFocus"
                                 KeyDown="OnRenameTextBoxKeyDown"/>

                        <!-- Location (검색 결과에서만 표시) -->
                        <Border Grid.Column="2" x:Name="LocationCell" Width="0">
                            <TextBlock Text="{x:Bind LocationPath, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Foreground="{ThemeResource SpanTextSecondaryBrush}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Date Modified (+ relative age badge, same colours as Miller) -->
                        <Border Grid.Column="3" x:Name="DateCell" Width="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{x:Bind RelativeAgeBrush, Mode=OneWay}"
                                        CornerRadius="2" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(HasRelativeAge), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind RelativeAgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#FF1A1A1A" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind DateModified, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                           Padding="6,0"/>
                            </Grid>
                        </Border>
                        <!-- Type -->
                        <Border Grid.Column="4" x:Name="TypeCell" Width="150">
                            <TextBlock Text="{x:Bind FileType, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Size -->
                        <Border Grid.Column="5" x:Name="SizeCell" Width="100">
                            <TextBlock Text="{x:Bind Size, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Date Created -->
                        <Border Grid.Column="6" Width="0" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind DateCreated, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Attributes -->
                        <Border Grid.Column="7" Width="0" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind AttributesText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Dimensions (Shell) -->
                        <Border Grid.Column="8" Width="0" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind DimensionsText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Duration (Shell) -->
                        <Border Grid.Column="9" Width="0" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind DurationText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Authors (Shell) -->
                        <Border Grid.Column="10" Width="0" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind AuthorsText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Title (Shell) -->
                        <Border Grid.Column="11" Width="0" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind TitleText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Git Status -->
                        <Border Grid.Column="12" x:Name="GitCell" Width="50">
                            <TextBlock Text="{x:Bind GitStatusText, Mode=OneWay}"
                                       Foreground="{x:Bind GitStatusBrush, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       FontWeight="Bold"
                                       Padding="6,0"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Grid>
    </Grid>
</UserControl>
